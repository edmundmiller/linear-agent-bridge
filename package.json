{
  "name": "linear-agent-bridge",
  "version": "0.1.3",
  "description": "Linear agent webhook integration for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "oxlint -c .oxlintrc.json index.ts src",
    "lint:anti-slop": "oxlint -c .oxlintrc.json index.ts src",
    "lint:strict": "oxlint -c .oxlintrc.strict.json index.ts src",
    "lint:jev": "node tools/oxlint/anti-slop/jev/lint-changed.ts -c .oxlintrc.jev.json --no-error-on-unmatched-pattern",
    "lint:jev:full": "node tools/oxlint/anti-slop/jev/lint-changed.ts --all -c .oxlintrc.jev.json index.ts src",
    "lint:diff": "node tools/oxlint/anti-slop/diff-rules/run.ts --working",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "linear",
    "agent",
    "webhook",
    "plugin"
  ],
  "author": "tokezooo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokezooo/linear-agent-bridge"
  },
  "bugs": {
    "url": "https://github.com/tokezooo/linear-agent-bridge/issues"
  },
  "homepage": "https://github.com/tokezooo/linear-agent-bridge#readme",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@types/node": "^20.19.33",
    "oxlint": "1.86.0",
    "oxlint-plugin-jev": "file:tools/oxlint/oxlint-plugin-jev",
    "typescript": "^5.0.0"
  }
}
